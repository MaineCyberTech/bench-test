{
  "openapi": "3.0.3",
  "info": {
    "title": "benchd control plane API",
    "version": "1.12.5",
    "description": "Machine-readable contract for the benchd control plane (server/benchd.py). It is generated by hand but kept honest by tests/test_contract.py, which checks it against the server's own route table (benchd.API_ROUTES) and the live dispatcher: every path+method here must exist there, and every route there must appear here. Prefix every /api/v1 path with the server origin. The auth expectations are described under securitySchemes and repeated per operation as x-required-role."
  },
  "servers": [
    {
      "url": "http://<lab-box>:8722",
      "description": "Substitute your lab values (host/port). Default port is 8722."
    }
  ],
  "tags": [
    {"name": "health", "description": "Unauthenticated liveness/readiness/observability."},
    {"name": "runner", "description": "Runner-facing: registration, heartbeat, commands, run writes."},
    {"name": "ui", "description": "Dashboard-facing read models."},
    {"name": "operator", "description": "Operator-only control and maintenance."},
    {"name": "commands", "description": "The command catalogue and the confirm contract."}
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": ["health"],
        "summary": "Liveness probe (cached, never touches the DB or the network).",
        "operationId": "getHealth",
        "x-required-role": "public",
        "security": [],
        "responses": {
          "200": {
            "description": "Liveness snapshot.",
            "content": {"application/json": {"schema": {"type": "object", "additionalProperties": true}}}
          }
        }
      }
    },
    "/ready": {
      "get": {
        "tags": ["health"],
        "summary": "Readiness probe: does a SQLite read+write and reports 503 when the DB is unusable.",
        "operationId": "getReady",
        "x-required-role": "public",
        "security": [],
        "responses": {
          "200": {"description": "Ready.", "content": {"application/json": {"schema": {"type": "object", "additionalProperties": true}}}},
          "503": {"description": "Not ready (database unusable).", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}
        }
      }
    },
    "/metrics": {
      "get": {
        "tags": ["health"],
        "summary": "Prometheus text exposition (counters + DB gauges).",
        "operationId": "getMetricsText",
        "x-required-role": "public",
        "security": [],
        "responses": {
          "200": {"description": "Prometheus text format.", "content": {"text/plain": {"schema": {"type": "string"}}}}
        }
      }
    },
    "/api/v1/stream": {
      "get": {
        "tags": ["ui"],
        "summary": "Server-sent events: snapshot/runner/run/phase/telemetry/command/log/schedule/event/artifact.",
        "operationId": "getStream",
        "x-required-role": "operator",
        "security": [{"operatorBearer": []}, {"operatorQuery": []}],
        "responses": {
          "200": {"description": "text/event-stream.", "content": {"text/event-stream": {"schema": {"type": "string"}}}},
          "401": {"description": "Unauthorized.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
          "503": {"description": "Too many subscribers.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}
        }
      }
    },
    "/api/v1/state": {
      "get": {
        "tags": ["ui"],
        "summary": "Dashboard snapshot: runners, active runs (+latest telemetry, phases, logs tail), recent runs, hosts, command_kinds, server_git, version.",
        "operationId": "getState",
        "x-required-role": "operator",
        "security": [{"operatorBearer": []}, {"operatorQuery": []}],
        "responses": {
          "200": {"description": "State snapshot.", "content": {"application/json": {"schema": {"type": "object", "additionalProperties": true}}}},
          "401": {"description": "Unauthorized.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}
        }
      }
    },
    "/api/v1/metrics": {
      "get": {
        "tags": ["ui"],
        "summary": "The metric catalogue (key -> label) used by trends/compare.",
        "operationId": "getMetricCatalogue",
        "x-required-role": "operator",
        "security": [{"operatorBearer": []}, {"operatorQuery": []}],
        "responses": {
          "200": {"description": "Metric catalogue.", "content": {"application/json": {"schema": {"type": "object", "additionalProperties": true}}}}
        }
      }
    },
    "/api/v1/commands": {
      "get": {
        "tags": ["commands"],
        "summary": "The command catalogue: every accepted kind with destructive/needs_confirm/description.",
        "operationId": "getCommandKinds",
        "x-required-role": "operator",
        "security": [{"operatorBearer": []}, {"operatorQuery": []}],
        "responses": {
          "200": {
            "description": "Command catalogue.",
            "content": {"application/json": {"schema": {"type": "object", "properties": {"commands": {"type": "array", "items": {"$ref": "#/components/schemas/CommandKind"}}}}}}
          }
        }
      }
    },
    "/api/v1/audit": {
      "get": {
        "tags": ["operator"],
        "summary": "The operator audit trail, newest first.",
        "operationId": "getAudit",
        "x-required-role": "operator",
        "security": [{"operatorBearer": []}, {"operatorQuery": []}],
        "parameters": [
          {"name": "limit", "in": "query", "required": false, "schema": {"type": "integer", "default": 100, "minimum": 1, "maximum": 1000}}
        ],
        "responses": {
          "200": {"description": "Audit rows.", "content": {"application/json": {"schema": {"type": "object", "additionalProperties": true}}}}
        }
      }
    },
    "/api/v1/runners": {
      "get": {
        "tags": ["ui"],
        "summary": "The fleet (all registered runners).",
        "operationId": "listRunners",
        "x-required-role": "operator",
        "security": [{"operatorBearer": []}, {"operatorQuery": []}],
        "responses": {
          "200": {"description": "Runner list.", "content": {"application/json": {"schema": {"type": "object", "additionalProperties": true}}}}
        }
      }
    },
    "/api/v1/runners/{runner_id}": {
      "delete": {
        "tags": ["operator"],
        "summary": "Delete a runner and everything it owns (runs + their data, commands, schedules).",
        "operationId": "deleteRunner",
        "x-required-role": "operator",
        "security": [{"operatorBearer": []}, {"operatorQuery": []}],
        "parameters": [{"$ref": "#/components/parameters/RunnerId"}],
        "responses": {
          "200": {"description": "Deleted.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Ok"}}}},
          "401": {"description": "Unauthorized.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}
        }
      }
    },
    "/api/v1/runners/{runner_id}/commands": {
      "get": {
        "tags": ["runner"],
        "summary": "Poll queued commands for this runner (drains the queue).",
        "operationId": "pollCommands",
        "x-required-role": "runner",
        "security": [{"operatorBearer": []}, {"operatorQuery": []}, {"runnerBearer": []}],
        "parameters": [{"$ref": "#/components/parameters/RunnerId"}],
        "responses": {
          "200": {"description": "Queued commands.", "content": {"application/json": {"schema": {"type": "object", "additionalProperties": true}}}},
          "401": {"description": "Unauthorized or expired key.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
          "403": {"description": "Not your runner.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}
        }
      },
      "post": {
        "tags": ["operator"],
        "summary": "Issue a command to a runner (operator only). Destructive kinds require payload.confirm=true.",
        "operationId": "issueCommand",
        "x-required-role": "operator",
        "security": [{"operatorBearer": []}, {"operatorQuery": []}],
        "parameters": [{"$ref": "#/components/parameters/RunnerId"}],
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CommandRequest"}}}
        },
        "responses": {
          "200": {"description": "Command queued.", "content": {"application/json": {"schema": {"type": "object", "properties": {"id": {"type": "string"}, "status": {"type": "string"}}}}}},
          "400": {"description": "Unknown kind, or a destructive kind without confirm=true.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
          "403": {"description": "Operator only, or refused by the exec allow/deny list.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}
        }
      }
    },
    "/api/v1/runners/{runner_id}/commands/{command_id}/ack": {
      "post": {
        "tags": ["runner"],
        "summary": "Acknowledge a command (the runner's own key or the operator).",
        "operationId": "ackCommand",
        "x-required-role": "runner",
        "security": [{"operatorBearer": []}, {"operatorQuery": []}, {"runnerBearer": []}],
        "parameters": [
          {"$ref": "#/components/parameters/RunnerId"},
          {"name": "command_id", "in": "path", "required": true, "schema": {"type": "string"}}
        ],
        "requestBody": {
          "required": false,
          "content": {"application/json": {"schema": {"type": "object", "properties": {"status": {"type": "string"}, "result": {"type": "object"}}}}}
        },
        "responses": {
          "200": {"description": "Acknowledged.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Ok"}}}},
          "404": {"description": "No such command.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}
        }
      }
    },
    "/api/v1/runners/{runner_id}/heartbeat": {
      "post": {
        "tags": ["runner"],
        "summary": "Liveness + status + capabilities for a runner.",
        "operationId": "heartbeat",
        "x-required-role": "runner",
        "security": [{"operatorBearer": []}, {"operatorQuery": []}, {"runnerBearer": []}],
        "parameters": [{"$ref": "#/components/parameters/RunnerId"}],
        "requestBody": {
          "required": false,
          "content": {"application/json": {"schema": {"type": "object", "properties": {"status": {"type": "string"}, "current_run": {"type": "string"}, "version": {"type": "string"}, "git": {"type": "string"}, "capabilities": {"type": "object"}}}}}
        },
        "responses": {
          "200": {"description": "Heartbeat accepted.", "content": {"application/json": {"schema": {"type": "object", "additionalProperties": true}}}},
          "401": {"description": "Unauthorized or expired key.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
          "404": {"description": "No such runner.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}
        }
      }
    },
    "/api/v1/runners/{runner_id}/rotate": {
      "post": {
        "tags": ["runner"],
        "summary": "Mint a new per-runner API key (the runner's own key or the operator); the old key stops at once.",
        "operationId": "rotateKey",
        "x-required-role": "runner",
        "security": [{"operatorBearer": []}, {"operatorQuery": []}, {"runnerBearer": []}],
        "parameters": [{"$ref": "#/components/parameters/RunnerId"}],
        "responses": {
          "200": {"description": "New key.", "content": {"application/json": {"schema": {"type": "object", "properties": {"runner_id": {"type": "string"}, "api_key": {"type": "string"}, "key_ttl_days": {"type": "integer"}}}}}},
          "404": {"description": "No such runner.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}
        }
      }
    },
    "/api/v1/schedules": {
      "get": {
        "tags": ["ui"],
        "summary": "List recurring run schedules.",
        "operationId": "listSchedules",
        "x-required-role": "operator",
        "security": [{"operatorBearer": []}, {"operatorQuery": []}],
        "responses": {
          "200": {"description": "Schedules.", "content": {"application/json": {"schema": {"type": "object", "additionalProperties": true}}}}
        }
      },
      "post": {
        "tags": ["operator"],
        "summary": "Create a recurring run schedule (operator only).",
        "operationId": "createSchedule",
        "x-required-role": "operator",
        "security": [{"operatorBearer": []}, {"operatorQuery": []}],
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {"type": "object", "properties": {"runner_id": {"type": "string"}, "label": {"type": "string"}, "kind": {"type": "string", "enum": ["every", "daily"]}, "every_s": {"type": "integer"}, "at_time": {"type": "string"}, "profile": {"type": "object"}}}}}
        },
        "responses": {
          "200": {"description": "Created.", "content": {"application/json": {"schema": {"type": "object", "properties": {"id": {"type": "string"}, "next_run": {"type": "number"}}}}}},
          "400": {"description": "runner_id required.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
          "403": {"description": "Operator only.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}
        }
      }
    },
    "/api/v1/schedules/{schedule_id}": {
      "delete": {
        "tags": ["operator"],
        "summary": "Remove a recurring schedule (operator only).",
        "operationId": "deleteSchedule",
        "x-required-role": "operator",
        "security": [{"operatorBearer": []}, {"operatorQuery": []}],
        "parameters": [{"name": "schedule_id", "in": "path", "required": true, "schema": {"type": "string"}}],
        "responses": {
          "200": {"description": "Deleted.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Ok"}}}}
        }
      }
    },
    "/api/v1/runs": {
      "get": {
        "tags": ["ui"],
        "summary": "Run history (paged), newest first.",
        "operationId": "listRuns",
        "x-required-role": "operator",
        "security": [{"operatorBearer": []}, {"operatorQuery": []}],
        "parameters": [
          {"name": "limit", "in": "query", "required": false, "schema": {"type": "integer", "default": 100, "minimum": 1, "maximum": 1000}},
          {"name": "offset", "in": "query", "required": false, "schema": {"type": "integer", "default": 0, "minimum": 0}},
          {"name": "host", "in": "query", "required": false, "schema": {"type": "string"}}
        ],
        "responses": {
          "200": {"description": "Runs page.", "content": {"application/json": {"schema": {"type": "object", "additionalProperties": true}}}}
        }
      },
      "post": {
        "tags": ["runner"],
        "summary": "Open a run (the operator, or a runner for itself).",
        "operationId": "createRun",
        "x-required-role": "runner",
        "security": [{"operatorBearer": []}, {"operatorQuery": []}, {"runnerBearer": []}],
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {"type": "object", "properties": {"runner_id": {"type": "string"}, "id": {"type": "string"}, "host": {"type": "string"}, "label": {"type": "string"}, "platform": {"type": "string"}, "gpu": {"type": "string"}, "driver": {"type": "string"}, "torch": {"type": "string"}, "preset": {"type": "string"}, "profile": {"type": "object"}, "system": {"type": "object"}}}}}
        },
        "responses": {
          "200": {"description": "Run opened.", "content": {"application/json": {"schema": {"type": "object", "properties": {"run_id": {"type": "string"}}}}}},
          "401": {"description": "Unauthorized.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
          "403": {"description": "Not your runner.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}
        }
      }
    },
    "/api/v1/runs/{run_id}": {
      "get": {
        "tags": ["ui"],
        "summary": "One run with its phases, events, artifacts, logs and telemetry stats.",
        "operationId": "getRun",
        "x-required-role": "operator",
        "security": [{"operatorBearer": []}, {"operatorQuery": []}],
        "parameters": [{"$ref": "#/components/parameters/RunId"}],
        "responses": {
          "200": {"description": "Run detail.", "content": {"application/json": {"schema": {"type": "object", "additionalProperties": true}}}},
          "404": {"description": "No such run.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}
        }
      },
      "delete": {
        "tags": ["operator"],
        "summary": "Delete a run and every row that belongs to it (operator only).",
        "operationId": "deleteRun",
        "x-required-role": "operator",
        "security": [{"operatorBearer": []}, {"operatorQuery": []}],
        "parameters": [{"$ref": "#/components/parameters/RunId"}],
        "responses": {
          "200": {"description": "Deleted.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Ok"}}}}
        }
      }
    },
    "/api/v1/runs/{run_id}/artifact/{name}": {
      "get": {
        "tags": ["ui"],
        "summary": "Download one attached artifact (binary-safe).",
        "operationId": "downloadArtifact",
        "x-required-role": "operator",
        "security": [{"operatorBearer": []}, {"operatorQuery": []}],
        "parameters": [{"$ref": "#/components/parameters/RunId"}, {"$ref": "#/components/parameters/ArtifactName"}],
        "responses": {
          "200": {"description": "Artifact bytes.", "content": {"application/octet-stream": {"schema": {"type": "string", "format": "binary"}}}},
          "404": {"description": "No such artifact.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}
        }
      },
      "delete": {
        "tags": ["operator"],
        "summary": "Remove one attached artifact (the run's owner or the operator); audited.",
        "operationId": "deleteArtifact",
        "x-required-role": "owner",
        "security": [{"operatorBearer": []}, {"operatorQuery": []}, {"runnerBearer": []}],
        "parameters": [{"$ref": "#/components/parameters/RunId"}, {"$ref": "#/components/parameters/ArtifactName"}],
        "responses": {
          "200": {"description": "Deleted.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Ok"}}}},
          "403": {"description": "Not your run.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
          "404": {"description": "No such run or artifact.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}
        }
      }
    },
    "/api/v1/runs/{run_id}/artifact": {
      "post": {
        "tags": ["runner"],
        "summary": "Attach a report/manifest (base64); sha256 recomputed and verified, size/quota/name enforced.",
        "operationId": "uploadArtifact",
        "x-required-role": "owner",
        "security": [{"operatorBearer": []}, {"operatorQuery": []}, {"runnerBearer": []}],
        "parameters": [{"$ref": "#/components/parameters/RunId"}],
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {"type": "object", "required": ["name"], "properties": {"name": {"type": "string"}, "kind": {"type": "string"}, "content": {"type": "string", "description": "base64"}, "sha256": {"type": "string"}}}}}
        },
        "responses": {
          "200": {"description": "Stored.", "content": {"application/json": {"schema": {"type": "object", "properties": {"ok": {"type": "boolean"}, "sha256": {"type": "string"}, "size": {"type": "integer"}}}}}},
          "400": {"description": "Invalid name/content, or a sha256 mismatch.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
          "413": {"description": "Too large, or the per-run quota is reached.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}
        }
      }
    },
    "/api/v1/runs/{run_id}/event": {
      "post": {
        "tags": ["runner"],
        "summary": "Append a run event line.",
        "operationId": "postEvent",
        "x-required-role": "owner",
        "security": [{"operatorBearer": []}, {"operatorQuery": []}, {"runnerBearer": []}],
        "parameters": [{"$ref": "#/components/parameters/RunId"}],
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {"type": "object", "properties": {"level": {"type": "string"}, "message": {"type": "string"}, "ts": {"type": "number"}}}}}
        },
        "responses": {
          "200": {"description": "Recorded.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Ok"}}}}
        }
      }
    },
    "/api/v1/runs/{run_id}/finish": {
      "post": {
        "tags": ["runner"],
        "summary": "Close a running run and attach its summary; a late/duplicate finish is 409.",
        "operationId": "finishRun",
        "x-required-role": "owner",
        "security": [{"operatorBearer": []}, {"operatorQuery": []}, {"runnerBearer": []}],
        "parameters": [{"$ref": "#/components/parameters/RunId"}],
        "requestBody": {
          "required": false,
          "content": {"application/json": {"schema": {"type": "object", "properties": {"status": {"type": "string"}, "exit_code": {"type": "integer"}, "summary": {"type": "object"}, "system": {"type": "object"}}}}}
        },
        "responses": {
          "200": {"description": "Closed.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Ok"}}}},
          "404": {"description": "No such run.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
          "409": {"description": "Run is not running.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}
        }
      }
    },
    "/api/v1/runs/{run_id}/log": {
      "post": {
        "tags": ["runner"],
        "summary": "Append run console lines.",
        "operationId": "postLog",
        "x-required-role": "owner",
        "security": [{"operatorBearer": []}, {"operatorQuery": []}, {"runnerBearer": []}],
        "parameters": [{"$ref": "#/components/parameters/RunId"}],
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {"type": "object", "properties": {"lines": {"type": "array", "items": {"type": "string"}}, "line": {"type": "string"}, "stream": {"type": "string"}}}}}
        },
        "responses": {
          "200": {"description": "Recorded.", "content": {"application/json": {"schema": {"type": "object", "properties": {"ok": {"type": "boolean"}, "n": {"type": "integer"}}}}}}
        }
      }
    },
    "/api/v1/runs/{run_id}/logs": {
      "get": {
        "tags": ["ui"],
        "summary": "The run's console lines, after a cursor.",
        "operationId": "getRunLogs",
        "x-required-role": "operator",
        "security": [{"operatorBearer": []}, {"operatorQuery": []}],
        "parameters": [
          {"$ref": "#/components/parameters/RunId"},
          {"name": "after", "in": "query", "required": false, "schema": {"type": "integer", "default": 0}},
          {"name": "limit", "in": "query", "required": false, "schema": {"type": "integer", "default": 2000, "minimum": 1, "maximum": 5000}}
        ],
        "responses": {
          "200": {"description": "Log lines.", "content": {"application/json": {"schema": {"type": "object", "additionalProperties": true}}}}
        }
      }
    },
    "/api/v1/runs/{run_id}/phase": {
      "post": {
        "tags": ["runner"],
        "summary": "Open/close a phase, keyed by (run_id, seq) so a replay is idempotent.",
        "operationId": "postPhase",
        "x-required-role": "owner",
        "security": [{"operatorBearer": []}, {"operatorQuery": []}, {"runnerBearer": []}],
        "parameters": [{"$ref": "#/components/parameters/RunId"}],
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {"type": "object", "properties": {"seq": {"type": "integer"}, "group": {"type": "string"}, "label": {"type": "string"}, "status": {"type": "string"}, "detail": {"type": "string"}, "t0": {"type": "number"}, "t1": {"type": "number"}}}}}
        },
        "responses": {
          "200": {"description": "Recorded.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Ok"}}}}
        }
      }
    },
    "/api/v1/runs/{run_id}/stats": {
      "get": {
        "tags": ["ui"],
        "summary": "Per-field n/min/avg/max/std/p50/p95/p99 plus derived energy, clock residency, throttled %, headroom.",
        "operationId": "getRunStats",
        "x-required-role": "operator",
        "security": [{"operatorBearer": []}, {"operatorQuery": []}],
        "parameters": [{"$ref": "#/components/parameters/RunId"}],
        "responses": {
          "200": {"description": "Statistics.", "content": {"application/json": {"schema": {"type": "object", "additionalProperties": true}}}}
        }
      }
    },
    "/api/v1/runs/{run_id}/telemetry": {
      "get": {
        "tags": ["ui"],
        "summary": "Downsampled telemetry series (named fields).",
        "operationId": "getRunTelemetry",
        "x-required-role": "operator",
        "security": [{"operatorBearer": []}, {"operatorQuery": []}],
        "parameters": [
          {"$ref": "#/components/parameters/RunId"},
          {"name": "max", "in": "query", "required": false, "schema": {"type": "integer", "default": 600, "minimum": 1, "maximum": 5000}}
        ],
        "responses": {
          "200": {"description": "Telemetry rows.", "content": {"application/json": {"schema": {"type": "object", "additionalProperties": true}}}}
        }
      },
      "post": {
        "tags": ["runner"],
        "summary": "Append batched telemetry samples (named dicts or positional lists).",
        "operationId": "postTelemetry",
        "x-required-role": "owner",
        "security": [{"operatorBearer": []}, {"operatorQuery": []}, {"runnerBearer": []}],
        "parameters": [{"$ref": "#/components/parameters/RunId"}],
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {"type": "object", "properties": {"samples": {"type": "array", "items": {"type": "object"}}}}}}
        },
        "responses": {
          "200": {"description": "Accepted.", "content": {"application/json": {"schema": {"type": "object", "properties": {"ok": {"type": "boolean"}, "accepted": {"type": "integer"}}}}}}
        }
      }
    },
    "/api/v1/runs/{run_id}/telemetry.csv": {
      "get": {
        "tags": ["ui"],
        "summary": "Full telemetry as a CSV download.",
        "operationId": "downloadTelemetryCsv",
        "x-required-role": "operator",
        "security": [{"operatorBearer": []}, {"operatorQuery": []}],
        "parameters": [{"$ref": "#/components/parameters/RunId"}],
        "responses": {
          "200": {"description": "CSV bytes.", "content": {"text/csv": {"schema": {"type": "string"}}}}
        }
      }
    },
    "/api/v1/register": {
      "post": {
        "tags": ["runner"],
        "summary": "Register a runner; adopts an existing row by machine_id+kind+instance; returns a per-runner api_key. The only route the join token is accepted on.",
        "operationId": "registerRunner",
        "x-required-role": "join",
        "security": [{"operatorBearer": []}, {"runnerBearer": []}, {"joinBearer": []}],
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {"type": "object", "properties": {"runner_id": {"type": "string"}, "name": {"type": "string"}, "os": {"type": "string"}, "kind": {"type": "string"}, "version": {"type": "string"}, "git": {"type": "string"}, "machine_id": {"type": "string"}, "instance": {"type": "string"}, "ephemeral": {"type": "boolean"}, "capabilities": {"type": "object"}, "api_key": {"type": "string"}}}}}
        },
        "responses": {
          "200": {"description": "Registered.", "content": {"application/json": {"schema": {"type": "object", "properties": {"runner_id": {"type": "string"}, "api_key": {"type": "string"}, "poll_interval": {"type": "number"}, "telemetry_interval": {"type": "number"}, "server_time": {"type": "number"}}}}}},
          "401": {"description": "Unauthorized.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
          "429": {"description": "Registration rate limited.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}
        }
      }
    },
    "/api/v1/server/update": {
      "post": {
        "tags": ["ui"],
        "summary": "Pull the control plane's own git checkout and restart it (operator only; a git deploy, not a copy-deploy).",
        "operationId": "serverUpdate",
        "x-required-role": "operator",
        "security": [{"operatorBearer": []}],
        "responses": {
          "200": {"description": "Updated (or already current).", "content": {"application/json": {"schema": {"type": "object", "additionalProperties": true}}}},
          "403": {"description": "Operator only.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}
        }
      }
    },
    "/api/v1/trends": {
      "get": {
        "tags": ["ui"],
        "summary": "Metric-over-time series for a host (or all hosts), with per-series median/p95/p99.",
        "operationId": "getTrends",
        "x-required-role": "operator",
        "security": [{"operatorBearer": []}, {"operatorQuery": []}],
        "parameters": [
          {"name": "host", "in": "query", "required": false, "schema": {"type": "string"}},
          {"name": "metric", "in": "query", "required": false, "schema": {"type": "array", "items": {"type": "string"}}}
        ],
        "responses": {
          "200": {"description": "Trends.", "content": {"application/json": {"schema": {"type": "object", "additionalProperties": true}}}}
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "operatorBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "The shared operator token (BENCHD_TOKEN), as an Authorization: Bearer header."
      },
      "operatorQuery": {
        "type": "apiKey",
        "in": "query",
        "name": "token",
        "description": "The operator token as ?token= (for SSE and file downloads, where a browser cannot set a header)."
      },
      "runnerBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "A per-runner API key issued by POST /api/v1/register."
      },
      "joinBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "The registration-only join token (BENCHD_JOIN_TOKEN); accepted by POST /api/v1/register alone."
      }
    },
    "parameters": {
      "RunnerId": {"name": "runner_id", "in": "path", "required": true, "schema": {"type": "string"}},
      "RunId": {"name": "run_id", "in": "path", "required": true, "schema": {"type": "string"}},
      "ArtifactName": {"name": "name", "in": "path", "required": true, "schema": {"type": "string"}}
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {"error": {"type": "string"}},
        "required": ["error"]
      },
      "Ok": {
        "type": "object",
        "properties": {"ok": {"type": "boolean"}}
      },
      "CommandKind": {
        "type": "object",
        "required": ["kind", "destructive", "needs_confirm", "description"],
        "properties": {
          "kind": {"type": "string"},
          "destructive": {"type": "boolean"},
          "needs_confirm": {"type": "boolean", "description": "true when payload.confirm must be exactly true."},
          "description": {"type": "string"}
        }
      },
      "CommandRequest": {
        "type": "object",
        "required": ["kind"],
        "properties": {
          "kind": {"type": "string", "description": "One of GET /api/v1/commands."},
          "payload": {"type": "object", "description": "Kind-specific payload; destructive kinds require confirm: true."}
        }
      }
    }
  }
}
