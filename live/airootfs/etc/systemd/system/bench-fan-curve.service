[Unit]
Description=bench-test GPU fan curve daemon
# Same cycle as bench-fan-auto: order before multi-user.target, not after it.
Before=multi-user.target
ConditionPathExists=/etc/bench-fan-curve.conf

[Service]
Type=simple
ExecStart=/usr/local/bin/bench-fan-curve run
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
