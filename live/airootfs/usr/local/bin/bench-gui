#!/usr/bin/env bash
# Launch the bench-test dashboard (starts X + openbox when no display is running).
# Checks in to the control plane when a config is present:
#   /etc/bench-agent.conf  or  /mnt/benchdata/bench-agent.conf
#     BENCHD_SERVER=http://lab:8722
#     BENCHD_TOKEN=...
set -u
for c in /etc/bench-agent.conf /mnt/benchdata/bench-agent.conf; do
    if [ -f "$c" ]; then set -a; . "$c"; set +a; break; fi
done
export DISPLAY="${DISPLAY:-:0}"
if ! xdpyinfo -display "$DISPLAY" >/dev/null 2>&1; then
    echo "[gui] starting X on $DISPLAY"
    X "$DISPLAY" vt2 -ac -nolisten tcp > /tmp/x.log 2>&1 &
    sleep 3
    openbox > /tmp/openbox.log 2>&1 &
    sleep 2
fi
exec python /opt/bench-test/bench/gui.py "$@"
