#!/usr/bin/env bash
# Copy bench-test results to the BENCHDATA partition of the USB stick.
#
# Save order:
#   1. mount the first usable vfat partition (probe-based, udev-independent)
#   2. raw log slot: if nothing mounts, write a BENCHLOG1 archive to the tail
#      of a stick partition - needs no filesystem at all; recover on the host
#      with  bench/rawlog.py <partition-device> <outdir>
#   3. /root/bench-results (RAM) - always also written as a working copy
#
# Exit: 0 = saved to a mounted stick partition, 4 = RAM only,
#       5 = RAM + raw log slot on the stick.
set -u

SRC="${1:-/opt/bench-test/results}"
LBL="${BENCHDATA_LABEL:-BENCHDATA}"

# --- make sure the kernel knows the partitions --------------------------
for d in /dev/sd? /dev/nvme?n? /dev/mmcblk?; do
    [ -b "$d" ] || continue
    partx -a "$d" >/dev/null 2>&1 || true
done
udevadm settle --timeout=10 2>/dev/null || true

# --- gather candidates: label -> direct probe -> big vfat -> any vfat ---
CANDS=""
add_cand() { [ -n "${1:-}" ] && CANDS="$CANDS $1"; }
# heuristic fallbacks only ever consider the boot stick: a partition is picked
# if it sits on a USB transport, on a device flagged removable, or on the
# physical disk that backs the running live ISO. An internal ESP can therefore
# never be mistaken for the benchmark stick.
is_stick_part() {
    local p="$1" path root_dev root_disk part_disk
    path="$(udevadm info -q path -n "$p" 2>/dev/null || true)"
    case "$path" in *usb*) return 0 ;; esac
    part_disk="$(lsblk -no PKNAME "$p" 2>/dev/null | head -1)"
    [ -n "$part_disk" ] && [ "$(cat "/sys/block/$part_disk/removable" 2>/dev/null)" = "1" ] && return 0
    root_dev="$(findmnt -no SOURCE /run/archiso/bootmnt 2>/dev/null || true)"
    [ -n "$root_dev" ] || return 1
    root_disk="$(lsblk -no PKNAME "$root_dev" 2>/dev/null | head -1)"
    [ -z "$root_disk" ] && root_disk="${root_dev#/dev/}"
    [ -n "$part_disk" ] && [ "$part_disk" = "$root_disk" ] && return 0
    return 1
}

[ -e "/dev/disk/by-label/$LBL" ] && add_cand "$(readlink -f "/dev/disk/by-label/$LBL")"
for p in /dev/sd*[0-9] /dev/nvme*n*p*[0-9] /dev/mmcblk*p*[0-9]; do
    [ -b "$p" ] || continue
    lb="$(blkid -p -o value -s LABEL "$p" 2>/dev/null || true)"
    [ "$lb" = "$LBL" ] && add_cand "$p"
done
for p in /dev/sd*[0-9] /dev/nvme*n*p*[0-9] /dev/mmcblk*p*[0-9]; do
    [ -b "$p" ] || continue
    sz="$(lsblk -bdno SIZE "$p" 2>/dev/null || echo 0)"
    ty="$(blkid -p -o value -s TYPE "$p" 2>/dev/null || true)"
    [ "$ty" = "vfat" ] && [ "${sz:-0}" -gt 1000000000 ] && is_stick_part "$p" && add_cand "$p"
done
for p in /dev/sd*[0-9] /dev/nvme*n*p*[0-9] /dev/mmcblk*p*[0-9]; do
    [ -b "$p" ] || continue
    ty="$(blkid -p -o value -s TYPE "$p" 2>/dev/null || true)"
    [ "$ty" = "vfat" ] && is_stick_part "$p" && add_cand "$p"
done

# --- mount the first candidate that works -------------------------------
DEST="" FOUND_DEV=""
MOUNT_ERR="$(mktemp)"
modprobe vfat 2>/dev/null || true
modprobe nls_cp437 2>/dev/null || true
modprobe nls_iso8859-1 2>/dev/null || true
for c in $CANDS; do
    mnt="$(findmnt -no TARGET --source "$c" 2>/dev/null | head -1)"
    if [ -n "$mnt" ] && [ -w "$mnt" ]; then
        DEST="$mnt" FOUND_DEV="$c"; break
    fi
    if ! mountpoint -q /mnt/benchdata; then
        mkdir -p /mnt/benchdata
        # if anything (initramfs, firmware) marked the device read-only, undo it
        blockdev --setrw "$c" 2>>"$MOUNT_ERR" || true
        mount -t vfat -o rw,umask=0022 "$c" /mnt/benchdata 2>>"$MOUNT_ERR" || true
    fi
    if mountpoint -q /mnt/benchdata; then
        DEST=/mnt/benchdata FOUND_DEV="$c"; break
    fi
done
if [ -z "$DEST" ] && mountpoint -q /mnt/benchdata; then
    DEST=/mnt/benchdata
fi

HOST="$(hostname -s 2>/dev/null)"
[ -n "$HOST" ] || HOST="bench-live"
STAMP="$(date +%Y%m%d-%H%M%S)"

write_diag() {  # $1 = output file
    {
        echo "collector: bench-collect v4"
        echo "timestamp: $(date -Iseconds)"
        echo "host: $HOST   kernel: $(uname -r)"
        echo "source: $SRC"
        echo "chosen device: ${FOUND_DEV:-none}   dest: ${DEST:-none}"
        echo "candidates:${CANDS:- none}"
        echo
        echo "--- lsblk ---"; lsblk -o NAME,SIZE,FSTYPE,LABEL,UUID,MOUNTPOINT 2>&1
        echo; echo "--- blkid -p (candidates) ---"
        for c in $CANDS; do echo "$c: $(blkid -p "$c" 2>&1)"; done
        echo; echo "--- /proc/partitions ---"; cat /proc/partitions
        echo; echo "--- /dev/sd* ---"; ls -l /dev/sd* 2>&1
        echo; for dd in /dev/sd?; do [ -b "$dd" ] && echo "$dd ro=$(blockdev --getro "$dd" 2>/dev/null)"; done
        echo; echo "--- mount attempts ---"; cat "${MOUNT_ERR:-/dev/null}" 2>/dev/null
        echo; echo "--- mount ---"; mount
        echo; echo "--- dmesg (tail) ---"; dmesg 2>/dev/null | tail -30
    } > "$1" 2>&1
}

# --- raw log slot: persistence that needs no mount at all ---------------
RAW_DEV=""
if [ -z "$DEST" ]; then
    for c in $CANDS; do
        [ -b "$c" ] || continue
        sz="$(blockdev --getsize64 "$c" 2>/dev/null || echo 0)"
        [ "${sz:-0}" -gt 1000000000 ] || continue
        tmp="$(mktemp -d)"
        mkdir -p "$tmp/payload"
        cp -a "$SRC/." "$tmp/payload/" 2>/dev/null || true
        write_diag "$tmp/payload/collect-diag.txt"
        if tar czf "$tmp/log.tgz" -C "$tmp/payload" . 2>/dev/null; then
            { printf 'BENCHLOG1\n%s\n' "$(stat -c %s "$tmp/log.tgz")"; cat "$tmp/log.tgz"; } > "$tmp/log.bin"
            if dd if="$tmp/log.bin" of="$c" bs=512 seek=$(( (sz - 67108864) / 512 )) conv=notrunc 2>/dev/null; then
                sync
                RAW_DEV="$c"
            fi
        fi
        rm -rf "$tmp"
        [ -n "$RAW_DEV" ] && break
    done
fi

FALLBACK=0
if [ -z "$DEST" ]; then
    FALLBACK=1
    DEST=/root/bench-results
    mkdir -p "$DEST"
    if [ -n "$RAW_DEV" ]; then
        echo "[collect] no mountable partition - wrote a raw log slot to $RAW_DEV (recover: bench/rawlog.py)"
    else
        echo "[collect] no writable BENCHDATA partition found - saving to $DEST (RAM - copy off before reboot!)"
    fi
fi

TARGET="$DEST/$HOST-$STAMP"
mkdir -p "$TARGET"
write_diag "$TARGET/collect-diag.txt"
cp -a "$SRC/." "$TARGET/" 2>/dev/null || true
# also drop the diag into the results dir itself: whatever uploads the results
# (auto-upload from RAM, manual 'u') then carries the in-guest device picture
cp "$TARGET/collect-diag.txt" "$SRC/collect-diag.txt" 2>/dev/null || true
# keep the diagnostics also in RAM for a post-reboot autopsy
mkdir -p /root/bench-results
cp "$TARGET/collect-diag.txt" "/root/bench-results/collect-diag-${STAMP}.txt" 2>/dev/null || true

{
    echo "host: $HOST"
    echo "collected: $(date -Iseconds)"
    echo "kernel: $(uname -r)"
    lspci -nn 2>/dev/null | grep -iE "VGA|3D|Display" || true
    free -h 2>/dev/null | head -2
} > "$TARGET/manifest.txt"

sync
echo "[collect] results copied to $TARGET"
if [ "$FALLBACK" = 1 ]; then
    if [ -n "$RAW_DEV" ]; then
        echo "[collect] WARNING: mount failed; the raw log slot on $RAW_DEV is the persistent copy"
        exit 5
    fi
    echo "[collect] WARNING: destination is RAM - back it up before rebooting"
    exit 4
fi
exit 0
