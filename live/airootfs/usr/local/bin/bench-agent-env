#!/bin/sh
# bench-agent-env - make the bench-test control-plane config available and export
# it for the dashboards/runner. Sourced by bench-tui / bench-gui / bench-live-run.
#
# Order: /etc/bench-agent.conf (baked into the image) first; otherwise mount the
# BENCHDATA partition on demand (it is often not mounted yet at boot, which is why
# a config dropped on the stick can be missed) and read /mnt/benchdata/bench-agent.conf.
set -u

conf=""
# BENCHDATA holds the persisted toolkit (remote self-update) and the results, so
# mount it whether or not the image also bakes a config - the re-point below and
# every run depend on it.
if ! mountpoint -q /mnt/benchdata 2>/dev/null; then
    dev="$(blkid -L BENCHDATA 2>/dev/null || true)"
    if [ -n "$dev" ]; then
        mkdir -p /mnt/benchdata 2>/dev/null || true
        i=0
        while [ "$i" -lt 6 ]; do
            mount "$dev" /mnt/benchdata 2>/dev/null && break
            i=$((i + 1)); sleep 1
        done
    fi
fi

if [ -f /etc/bench-agent.conf ]; then
    conf=/etc/bench-agent.conf
elif [ -f /mnt/benchdata/bench-agent.conf ]; then
    conf=/mnt/benchdata/bench-agent.conf
fi

if [ -n "$conf" ]; then
    # Parse the known keys instead of sourcing the file. BENCHDATA is a FAT
    # partition that anyone holding the stick can write, and this runs as root at
    # boot: `.` on it would execute whatever it contains, and would also let it
    # rewrite PATH/LD_PRELOAD. Only these keys are honoured; everything else is
    # ignored.
    while IFS= read -r line || [ -n "$line" ]; do
        case "$line" in \#*|"") continue ;; esac
        key=${line%%=*}
        # Only keys a reader actually consumes are honoured (INFRA-P3-001 /
        # SECRET-P3-002): BENCHD_SERVER/BENCHD_TOKEN (benchreport.load_conf),
        # BENCH_AGENT_NAME (benchreport.Reporter.name) and BENCH_AGENT_INSTANCE
        # (Reporter.instance / bench-tui@.service). BENCHD_INSECURE was dropped:
        # no client implements a TLS-verify toggle, so accepting it advertised an
        # insecure escape hatch that silently did nothing.
        case "$key" in
            BENCHD_SERVER|BENCHD_TOKEN|BENCH_AGENT_NAME|BENCH_AGENT_INSTANCE)
                # FAT files carry CRLF; values may be quoted
                val=$(printf '%s' "${line#*=}" | tr -d '\r' \
                      | sed -e 's/^"//' -e 's/"$//' -e "s/^'//" -e "s/'$//")
                export "$key=$val"
                ;;
            *) : ;;
        esac
    done < "$conf"
    echo "[bench] control-plane config: $conf -> ${BENCHD_SERVER:-?}"
else
    echo "[bench] no control-plane config (drop bench-agent.conf on BENCHDATA or bake /etc/bench-agent.conf)"
fi

# FurMark (the gfx phase) lives outside the toolkit copy, like PyTorch, so that a
# toolkit re-point cannot hide it; the phase reads $FURMARK
for fm in "${BENCH_PERSIST_DIR:-/mnt/benchdata}/tools/FurMark_linux64/furmark" \
          /opt/bench-tools/furmark/FurMark_linux64/furmark; do
    if [ -x "$fm" ]; then export FURMARK="$fm"; break; fi
done

# the image's PyTorch lives outside the toolkit dir; keep it reachable before the
# re-point below replaces /opt/bench-test (otherwise every GPU phase loses torch)
for py in /usr/bin/python /usr/bin/python3 python3; do
    if command -v "$py" >/dev/null 2>&1; then
        "$py" /opt/bench-test/bench/live_update.py torch-link 2>/dev/null || true
        break
    fi
done

# a toolkit fetched by the control plane (remote self-update) lives on BENCHDATA;
# re-point /opt/bench-test at it so the update survives a reboot without reflashing
for py in /usr/bin/python /usr/bin/python3 python3; do
    if command -v "$py" >/dev/null 2>&1; then
        "$py" /opt/bench-test/bench/live_update.py boot-link 2>/dev/null || true
        break
    fi
done
