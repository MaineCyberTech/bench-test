# Normalise line endings so shell tooling is not broken by a Windows checkout.
# Shell scripts MUST be LF (they run on Linux / the live USB and in WSL/git-bash);
# PowerShell is kept CRLF for Windows tools.
* text=auto
*.sh text eol=lf
*.py text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.conf text eol=lf
*.service text eol=lf
*.xml text eol=lf
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.png binary
*.iso binary
*.xz binary
*.zst binary
