# results output (generated)
results/
*.log
# ....except logs inside example run reviews (evidence is part of the review)
!examples/**/*.log

# live USB build output (multi-GB ISOs)
live/out*/

# private build inputs (upload token etc.) - never commit
live/private/

# python
__pycache__/
*.pyc

# app packaging output (PyInstaller)
dist/
build/
*.spec

# downloaded tools (LibreHardwareMonitor etc.)
tools/
.venv/

# control-plane runtime data (sqlite db, blobs) and private config
server/data/
server/benchd.conf

# editor
.vscode/
.idea/
Thumbs.db
.DS_Store
